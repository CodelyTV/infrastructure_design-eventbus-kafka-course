#              MOOC              #
#--------------------------------#
MOOC_BACKEND_SERVER_PORT=8030
# PostgreSQL
MOOC_DATABASE_HOST=codely-java_ddd_example-postgres
MOOC_DATABASE_PORT=5432
MOOC_DATABASE_NAME=mooc
MOOC_DATABASE_USER=root
MOOC_DATABASE_PASSWORD=

#           BACKOFFICE           #
#--------------------------------#
BACKOFFICE_BACKEND_SERVER_PORT=8040
BACKOFFICE_FRONTEND_SERVER_PORT=8041
# PostgreSQL
BACKOFFICE_DATABASE_HOST=codely-java_ddd_example-postgres
BACKOFFICE_DATABASE_PORT=5432
BACKOFFICE_DATABASE_NAME=backoffice
BACKOFFICE_DATABASE_USER=root
BACKOFFICE_DATABASE_PASSWORD=

#             KAFKA             #
#--------------------------------#
KAFKA_BOOTSTRAP_SERVERS=shared_kafka:29092
KAFKA_DOMAIN_EVENTS_TOPIC=codely.mooc.domain_events
KAFKA_MAX_BLOCK_MS=3000

#            FAILOVER           #
#--------------------------------#
FAILOVER_DATABASE_HOST=codely-java_ddd_example-postgres
FAILOVER_DATABASE_PORT=5432
FAILOVER_DATABASE_NAME=mooc
FAILOVER_DATABASE_USER=root
FAILOVER_DATABASE_PASSWORD=
