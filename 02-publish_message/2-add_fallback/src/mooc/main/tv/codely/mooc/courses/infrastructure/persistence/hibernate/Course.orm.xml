<?xml version="1.0" encoding="utf-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_2.xsd"
                 version="3.2">

    <entity class="tv.codely.mooc.courses.domain.Course" access="FIELD">
        <table name="courses" />

        <attributes>
            <embedded-id name="id">
                <attribute-override name="value">
                    <column name="id" length="36" />
                </attribute-override>
            </embedded-id>

            <embedded name="name">
                <attribute-override name="value">
                    <column name="name" />
                </attribute-override>
            </embedded>

            <embedded name="duration">
                <attribute-override name="value">
                    <column name="duration" />
                </attribute-override>
            </embedded>
        </attributes>
    </entity>

    <embeddable class="tv.codely.mooc.courses.domain.CourseId" access="FIELD" />
    <embeddable class="tv.codely.mooc.courses.domain.CourseName" access="FIELD" />
    <embeddable class="tv.codely.mooc.courses.domain.CourseDuration" access="FIELD" />
</entity-mappings>
